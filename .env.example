# Gemini API key for local use. Never commit the real value.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional per-stage overrides (comma-separated fallbacks allowed)
# GEMINI_ANALYSIS_MODEL=gemini-2.5-flash
# GEMINI_CONTENT_MODEL=gemini-2.5-flash
# GEMINI_VALIDATION_MODEL=gemini-2.5-flash
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# SQLite is used automatically when DATABASE_URL is empty.
# SQLITE_PATH=data/seo_content.sqlite

# Optional PostgreSQL. Leave DATABASE_URL empty to stay on SQLite.
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB==content
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your_password_here
# DATABASE_URL=postgresql+psycopg://postgres:your_password_here@localhost:5432/=content

# Optional Vertex AI fallback. Not required when GEMINI_API_KEY is set.
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global

# Stored with each run
# PIPELINE_VERSION=1.0.0

# Gemini call budget. Defaults keep planning + content + at most one revision.
# GEMINI_TIMEOUT_SECONDS=60
# GEMINI_MAX_ATTEMPTS=2
# GEMINI_RETRY_MIN_SECONDS=1
# GEMINI_RETRY_MAX_SECONDS=8
# GEMINI_MAX_MODELS=1

# PostgreSQL pool and timeouts. Startup never drops existing data.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_POOL_TIMEOUT_SECONDS=10
# DB_POOL_RECYCLE_SECONDS=1800
# DB_CONNECT_TIMEOUT_SECONDS=5
# DB_STATEMENT_TIMEOUT_MS=15000
# DB_LOCK_TIMEOUT_MS=5000
# DB_MAX_ATTEMPTS=2
# POSTGRES_HOST_OVERRIDE=

# Request and cost limits.
# MAX_TOPIC_LENGTH=200
# MAX_WEBSITE_DESCRIPTION_LENGTH=600
# MAX_EXISTING_CONTENT_LENGTH=12000
# MAX_REQUEST_CHARS=20000
# MAX_LIST_ITEMS=40
# FULL_MIN_WORDS=700
# FULL_MAX_WORDS=1500
# SIMPLE_MIN_WORDS=350
# SIMPLE_MAX_WORDS=800
# MAX_CONCURRENT_GENERATIONS=2
# MAX_REQUESTS_PER_MINUTE=6
# DAILY_LIMIT_PER_CLIENT=20
# DAILY_LIMIT_GLOBAL=40

# Logging and process.
# LOG_FORMAT=text
# PORT=8080
# RUN_MIGRATIONS=1
# HEALTHCHECK_PATH=/health
